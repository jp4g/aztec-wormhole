# Wormhole Spy Service
SPY_RPC_HOST=localhost:7073

# ============================================
# For EVM Relay (Aztec -> EVM)
# Run with: ./wormhole-relayer evm
# ============================================
# Source chain ID (Aztec = 56)
CHAIN_ID=56

# EVM target configuration
EVM_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
EVM_TARGET_CONTRACT=0x...
PRIVATE_KEY=0x...

# ============================================
# For Aztec Relay (EVM -> Aztec)
# Run with: ./wormhole-relayer aztec
# ============================================
# Source chain ID (Arbitrum Sepolia = 10003)
# CHAIN_ID=10003

# Aztec target configuration
AZTEC_PXE_URL=https://devnet.aztec-labs.com/
AZTEC_WALLET_ADDRESS=0x...
AZTEC_TARGET_CONTRACT=0x...

# Optional verification service
VERIFICATION_SERVICE_URL=
