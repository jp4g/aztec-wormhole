{
  "name": "@aztec-wormhole/contracts",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "authors": ["Wormhole", "Nethermind", "Aztec Pioneers"],
  "main": "./dist/node/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "node": "./dist/node/index.js",
      "browser": "./dist/browser/index.js",
      "default": "./dist/node/index.js"
    },
    "./artifacts": {
      "types": "./dist/types/artifacts/index.d.ts",
      "node": "./dist/node/artifacts/index.js",
      "browser": "./dist/browser/artifacts/index.js",
      "default": "./dist/node/artifacts/index.js"
    }
  },
  "dependencies": {
    "@aztec/accounts": "3.0.0-devnet.3",
    "@aztec/aztec": "3.0.0-devnet.3",
    "@aztec/aztec.js": "3.0.0-devnet.3",
    "@aztec/constants": "3.0.0-devnet.3",
    "@aztec/end-to-end": "3.0.0-devnet.3",
    "@aztec/entrypoints": "3.0.0-devnet.3",
    "@aztec/ethereum": "3.0.0-devnet.3",
    "@aztec/noir-contracts.js": "3.0.0-devnet.3",
    "@aztec/stdlib": "3.0.0-devnet.3",
    "@aztec/test-wallet": "3.0.0-devnet.3",
    "@certusone/wormhole-sdk": "^0.10.18",
    "@jest/globals": "^30.0.5",
    "@types/bun": "latest",
    "@types/jest": "^30.0.0",
    "@wormhole-foundation/sdk": "^3.11.0",
    "dotenv": "^17.2.1",
    "jest": "^30.0.5",
    "typescript": "^5.0.0",
    "viem": "^2.38.6"
  },
  "scripts": {
    "build:contracts": "bun run ./scripts/compile.ts",
    "build:node": "bun build ./src/index.ts ./src/artifacts/index.ts --outdir ./dist/node --target=node --sourcemap",
    "build:browser": "bun build ./src/index.ts ./src/artifacts/index.ts --outdir ./dist/browser --target=browser --sourcemap",
    "build:types": "tsc -p ./tsconfig.types.json",
    "build": "bun run build:contracts && bun run build:ts",
    "build:ts": "bun run build:node && bun run build:browser && bun run build:types",
    "mint": "bun run ./scripts/mint.ts",
    "setup:accounts": "bun run ./scripts/setupAccounts.ts",
    "setup:deploy": "bun run ./scripts/deploy.ts",
    "bridge:out": "bun run ./scripts/bridge.ts"
  }
}
