# ============================================
# Aztec-Wormhole Bridge Configuration
# ============================================

# ============================================
# AZTEC CONFIGURATION
# ============================================

# Aztec node URL (devnet or local PXE)
L2_NODE_URL=https://devnet.aztec-labs.com/

# Your Aztec private key (Schnorr) - for deploy scripts
AZTEC_PRIVATE_KEY=0x...

# Aztec contract addresses (auto-populated by deploy script)
WORMHOLE_CONTRACT=0x...
TOKEN_CONTRACT=0x...
AZTEC_BRIDGE_ADDRESS=0x...
AZTEC_EMITTER_ADDRESS=0x...
AZTEC_RECEIVER_ADDRESS=0x...

# ============================================
# ARBITRUM / EVM CONFIGURATION
# ============================================

# Arbitrum Sepolia RPC URL
ARBITRUM_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Private key for EVM transactions (used by relayer and configure script)
PRIVATE_KEY=0x...

# EVM TokenBridge contract address (auto-populated by configure script)
EVM_BRIDGE_ADDRESS=0x...

# Optional: EVM token address for remote token mapping
EVM_TOKEN_ADDRESS=0x...

# Address to receive donation tokens
DONATION_RECEIVER=0x...

# ============================================
# RELAYER / SERVICE CONFIGURATION
# ============================================

# Wormhole Spy service (for Docker Compose, use wormhole-spy:7073)
SPY_RPC_HOST=localhost:7073

# Log level for relayer (debug, info, warn, error)
LOG_LEVEL=info

# Optional: VAA verification service URL
VERIFICATION_SERVICE_URL=

# ============================================
# FRONTEND (if applicable)
# ============================================

NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_CONTRACT_ADDRESS=
